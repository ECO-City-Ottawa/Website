# Gmail SMTP credentials used to send the Contact, Volunteer, and Newsletter
# form submissions by email (no database — every submission just becomes an email).
#
# Setup:
# 1. Use a Google account you control. A dedicated address (e.g. forms@ecocityottawa.ca,
#    or a plain Gmail account for now) works better long-term than a personal inbox.
# 2. Turn on 2-Step Verification on that account.
# 3. Create an App Password at https://myaccount.google.com/apppasswords
#    (choose "Mail" as the app) — it's a 16-character code, NOT your normal password.
# 4. Copy this file to .env.local and fill in the values below. .env.local is
#    gitignored, so real credentials never get committed.

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where form submissions get sent. Leave blank to default to GMAIL_USER.
# Use your own address to test for now; swap in the real destination(s) later.
CONTACT_TO_EMAIL=
